# ==========================================
# 1. DATABASE CONFIGURATION (Prisma)
# ==========================================
# For local development (SQLite):
DATABASE_URL="file:./dev.db"

# For production deployment (e.g. Supabase / Neon / PostgreSQL / Turso):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ==========================================
# 2. BACKEND / SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# ==========================================
# 3. FRONTEND CONFIGURATION (Vite)
# ==========================================
# Optional on Netlify: Leave empty or omit if using Netlify functions (it defaults to same-domain /api automatically)
# If using a separate backend server (e.g., on Render/Railway), specify the URL:
# VITE_API_URL=https://your-backend-api.onrender.com
